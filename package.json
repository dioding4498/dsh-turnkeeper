{
  "name": "dsh-turnkeeper",
  "version": "0.4.3",
  "type": "module",
  "description": "Measures each turn's model, tool and idle time, writes one JSONL record per turn, and blocks runaway tool use with a dynamic step gate, a retry breaker and a slow-command block. Renders the per-turn breakdown as a card in the conversation and a ledger view beside it.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": "dioding4498",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dioding4498/dsh-turnkeeper.git"
  },
  "bugs": {
    "url": "https://github.com/dioding4498/dsh-turnkeeper/issues"
  },
  "homepage": "https://github.com/dioding4498/dsh-turnkeeper#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "turnkeeper",
    "usage",
    "guardrails"
  ]
}